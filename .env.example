# The data agent's model: any endpoint speaking the OpenAI protocol.
# Empty means catalogue questions are answered without a model, and the page says so.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Empty: Bid Summary uses the synthetic CRM in the database. Set: HubSpot CRM v3.
HUBSPOT_TOKEN=

# Shared secret for every write. Empty refuses every write.
DEMO_WRITE_TOKEN=

CORS_ORIGINS=http://localhost:5261
